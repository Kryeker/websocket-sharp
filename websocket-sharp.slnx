<Solution>
  <Configurations>
    <BuildType Name="Debug" />
    <BuildType Name="Debug_Ubuntu" />
    <BuildType Name="Release" />
    <BuildType Name="Release_Ubuntu" />
  </Configurations>
  <Project Path="Example/Example.csproj" />
  <Project Path="Example2/Example2.csproj" />
  <Project Path="Example3/Example3.csproj" />
  <Project Path="websocket-sharp/websocket-sharp.csproj" />
  <Properties Name="MonoDevelopProperties">
    <Property Name="$0.CSharpFormattingPolicy" Value="$2" />
    <Property Name="$0.TextStylePolicy" Value="$1" />
    <Property Name="$1.inheritsSet" Value="null" />
    <Property Name="$1.scope" Value="text/x-csharp" />
    <Property Name="$2.inheritsScope" Value="text/x-csharp" />
    <Property Name="$2.inheritsSet" Value="Mono" />
    <Property Name="$2.scope" Value="text/x-csharp" />
    <Property Name="Policies" Value="$0" />
    <Property Name="StartupItem" Value="websocket-sharp\websocket-sharp.csproj" />
  </Properties>
</Solution>
